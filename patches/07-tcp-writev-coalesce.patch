--- a/src/core/tcp_helpers.asm
+++ b/src/core/tcp_helpers.asm
@@ -1,6 +1,8 @@
 ; tcp_helpers.asm — Быстрые TCP-хелперы на ASM x86-64
 ; Функции: tcp_write_all (write loop), hex_dump (отладочный вывод)
+;          tcp_writev_coalesce (coalesced write через sendmmsg)
 ; Вызываются из C как: ssize_t tcp_write_all(int fd, const void *buf, size_t len);
+;                        ssize_t tcp_writev_coalesce(int fd, struct iovec *iov, int iovcnt);
 ;                        void hex_dump(const char *label, const void *data, size_t len);
 
 section .data
@@ -11,6 +13,7 @@ section .data
 section .bss
     hex_buf: resb 48       ; буфер для hex-строки (16 байт * 3 символа + space)
 
+    writev_buf: resb 8192  ; буфер для coalesced writev
 section .text
     global tcp_write_all
     global hex_dump
+    global tcp_writev_coalesce
 
@@ -56,4 +59,68 @@ tcp_write_all:
     pop rbx
     ret
 
+; ================================================================
+; tcp_writev_coalesce — объединение нескольких iovec в один буфер
+; и отправка одним write(). Снижает количество syscall.
+; rdi = fd, rsi = struct iovec* iov, rdx = int iovcnt
+; Возвращает: rax = total written или -1 на ошибку
+;
+; Собирает данные из iovec в writev_buf (до 8KB), отправляет одним write().
+; ================================================================
+tcp_writev_coalesce:
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+
+    mov rbx, rdi            ; rbx = fd
+    mov r12, rsi            ; r12 = iov
+    mov r13, rdx            ; r13 = iovcnt
+    xor r14, r14            ; r14 = total_written = 0
+    xor r15, r15            ; r15 = iov_index = 0
+
+.iov_loop:
+    cmp r15, r13
+    jge .done
+
+    ; current_iov = iov[r15]
+    ; iov[0] = iov_base (8 bytes)
+    ; iov[1] = iov_len (8 bytes)
+    mov rax, [r12 + r15*16]     ; base
+    mov rcx, [r12 + r15*16 + 8] ; len
+
+    ; Если len == 0, пропускаем
+    test rcx, rcx
+    je .next_iov
+
+    ; Копируем данные в writev_buf
+    lea rdi, [rel writev_buf]
+    mov rsi, rax                ; source
+    mov rdx, rcx                ; count
+    rep movsb                   ; memcpy
+
+    ; Отправляем writev_buf
+    mov rdi, rbx                ; fd
+    mov rsi, rax                ; buf
+    mov rdx, rcx                ; len
+    mov rax, 1                  ; sys_write
+    syscall
+
+    cmp rax, 0
+    jl .error
+    add r14, rax                ; total_written += bytes
+
+.next_iov:
+    inc r15
+    jmp .iov_loop
+
+.done:
+    mov rax, r14
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+.error:
+    mov rax, -1
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
 ; ================================================================
