+/* Хеш-функция для session_id */
+static inline uint32_t session_hash_func(uint64_t session_id) {
+    return (uint32_t)(session_id % SESSION_HASH_SIZE);
+}
+
+/* Добавление сессии в хеш-таблицу */
+static inline void session_hash_add(uint64_t session_id, int index) {
+    uint32_t h = session_hash_func(session_id);
+    session_hash[h] = index;
+}
+
+/* Удаление сессии из хеш-таблицы */
+static inline void session_hash_remove(uint64_t session_id) {
