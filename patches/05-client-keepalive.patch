+/* Отправка keepalive-пакета */
+static void send_keepalive(int udp_fd, struct sockaddr_in *addr) {
+    gost_packet_t pkt;
+    memset(&pkt, 0, sizeof(pkt));
+    pkt.magic = htonl(GOST_PROXY_MAGIC);
+    pkt.type = PKT_KEEPALIVE;
+    pkt.session_id = htonll(session.session_id);
+    ssize_t sent = sendto(udp_fd, &pkt, sizeof(pkt), 0,
+                          (struct sockaddr *)addr, sizeof(*addr));
+    if (sent < 0 && errno != EINTR) {
+        log_debug("keepalive sendto: %s", strerror(errno));
+    }
+}
+
+/* Периодическая отправка keepalive */
+static void* keepalive_thread(void *arg) {
+    while (running) {
+        sleep(KEEPALIVE_INTERVAL);
+        if (!running) break;
+        pthread_mutex_lock(&keepalive_lock);
+        send_keepalive(sockfd, &server_addr);
+        pthread_mutex_unlock(&keepalive_lock);
+    }
+    return NULL;
+}
 
