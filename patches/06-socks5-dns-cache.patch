+/* DNS-кэш */
+typedef struct {
+    char domain[256];
+    uint32_t addr;  /* network byte order */
+    time_t expiry;
+    uint8_t resolved;
+} dns_cache_entry_t;
+
+static dns_cache_entry_t dns_cache[DNS_CACHE_SIZE];
+static pthread_mutex_t dns_cache_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* Найти запись в DNS-кэше */
+static int dns_cache_lookup(const char *domain, uint32_t *out_addr) {
+    pthread_mutex_lock(&dns_cache_lock);
+    time_t now = time(NULL);
+    for (int i = 0; i < DNS_CACHE_SIZE; i++) {
+        if (dns_cache[i].resolved &&
+            strcmp(dns_cache[i].domain, domain) == 0 &&
+            now < dns_cache[i].expiry) {
+            *out_addr = dns_cache[i].addr;
+            pthread_mutex_unlock(&dns_cache_lock);
+            return 0;
+        }
+        /* Протухшие записи — удаляем */
+        if (dns_cache[i].resolved && now >= dns_cache[i].expiry) {
+            dns_cache[i].resolved = 0;
+        }
+    }
+    pthread_mutex_unlock(&dns_cache_lock);
+    return -1;
+}
+
+/* Добавить запись в DNS-кэш */
+static void dns_cache_store(const char *domain, uint32_t addr) {
+    pthread_mutex_lock(&dns_cache_lock);
+    /* Ищем свободный слот или перетираем первую попавшуюся */
+    int slot = -1;
+    for (int i = 0; i < DNS_CACHE_SIZE; i++) {
+        if (!dns_cache[i].resolved) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot < 0) slot = 0; /* Перезаписываем */
+    strncpy(dns_cache[slot].domain, domain, sizeof(dns_cache[slot].domain) - 1);
+    dns_cache[slot].domain[sizeof(dns_cache[slot].domain) - 1] = '\0';
+    dns_cache[slot].addr = addr;
+    dns_cache[slot].expiry = time(NULL) + DNS_CACHE_TTL;
+    dns_cache[slot].resolved = 1;
+    pthread_mutex_unlock(&dns_cache_lock);
+}
+
+/* Очистка DNS-кэша */
+void dns_cache_cleanup(void) {
+    pthread_mutex_lock(&dns_cache_lock);
+    for (int i = 0; i < DNS_CACHE_SIZE; i++) {
+        dns_cache[i].resolved = 0;
+    }
+    pthread_mutex_unlock(&dns_cache_lock);
+}
 
